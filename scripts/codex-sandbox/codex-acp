#!/bin/sh
# Launcher for the Pimia Codex sandbox shim (see codex-acp-shim.mjs).
#
# Deliberately named `codex-acp`: buzz-acp derives a runtime's identity from the
# command basename (`normalize_agent_command_identity`), so an agent pointed at
# this file by absolute path is still recognised as a Codex agent and still gets
# the Codex argument and environment defaults.
#
# Point a managed agent at this file with `agent_command_override`, and select
# the mode with `INITIAL_AGENT_MODE=agent-workspace-network`.
set -eu

# Resolved with builtins only: managed agents are spawned with a curated PATH,
# and a launcher that needs `dirname` on it would fail with a misleading
# "missing shim" error rather than an honest one.
case "$0" in
    */*) SELF_DIR=$(CDPATH= cd -- "${0%/*}" && pwd -P) ;;
    *) SELF_DIR=$(CDPATH= cd -- . && pwd -P) ;;
esac
SHIM="$SELF_DIR/codex-acp-shim.mjs"

if [ ! -f "$SHIM" ]; then
    echo "pimia-codex-sandbox: missing $SHIM" >&2
    exit 1
fi

# The desktop ships its own Node for managed agents and does not put it on PATH,
# so prefer that one: it is the interpreter the adapter is installed against.
if [ -n "${PIMIA_CODEX_SHIM_NODE:-}" ]; then
    NODE_BIN="$PIMIA_CODEX_SHIM_NODE"
else
    NODE_BIN=""
    case "$(uname -s)" in
        Darwin) DATA_DIR="$HOME/Library/Application Support" ;;
        *) DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}" ;;
    esac
    # <data>/Buzz/runtimes/node/<version>/<platform>/bin/node — globbed rather
    # than pinned so a managed-Node upgrade does not strand the shim.
    for candidate in "$DATA_DIR"/Buzz/runtimes/node/*/*/bin/node; do
        if [ -x "$candidate" ]; then
            NODE_BIN="$candidate"
            break
        fi
    done
    if [ -z "$NODE_BIN" ]; then
        NODE_BIN=$(command -v node || true)
    fi
fi

if [ -z "$NODE_BIN" ] || [ ! -x "$NODE_BIN" ]; then
    echo "pimia-codex-sandbox: no usable node found (set PIMIA_CODEX_SHIM_NODE)" >&2
    exit 1
fi

exec "$NODE_BIN" "$SHIM" "$@"
