# Build artifacts
/target/
/dist/
/admin-web/dist/

# Python cache
__pycache__/
*.pyc

# lefthook-generated hook scripts (machine-specific)
.hooks/

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# Editor / IDE
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo
*~
.*.sw?

# OS artifacts
.DS_Store
Thumbs.db

# Scratch / working files (AI reviews, notes, drafts)
.scratch/

# Playwright artifacts
playwright-report/
test-results/
blob-report/
.playwright-mcp/

# Node modules (pnpm workspace hoists to root)
node_modules/

# Root npm lockfiles are accidental; desktop uses pnpm in /desktop.
/package-lock.json

# sqlx offline query data (generated, not portable)
.sqlx/

# SQLite database (created by relay in CWD)
buzz.db
buzz.db-wal
buzz.db-shm

# Docker volumes (if mounted locally)
mysql-data/
typesense-data/

# Hermit (toolchain manager cache)
.hermit/
doc/
/repos/

# Local identity files
identity.key
**/identity.key

# Claves, certificados y perfiles de firma. Ninguno está versionado hoy; esto
# es para que no lo esté nunca por descuido. En un repo público un secreto
# empujado ya no se arregla borrando el fichero: hay que rotarlo.
*.pem
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.p8
id_rsa
id_ed25519
# El `.key` de firma del updater de Tauri (`tauri signer generate`). La pública
# que acompaña es `.key.pub`, que no cae en este patrón y sigue versionable.
*.key

# Claude Code worktrees
.claude/worktrees/

# mesh-llm build cache
.cache/

# Helm dependency tarballs — regenerable from Chart.lock via `helm dependency build`
deploy/charts/*/charts/*.tgz
